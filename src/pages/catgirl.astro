---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Secret Braize catgirl sanctuary." />
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <title>Catgirl Sanctuary</title>
  </head>
  <body>
    <main>
      <p class="secret">BRAIZE SECRET FILE ᓚᘏᗢ</p>
      <section class="card">
        <div class="tape tape-left"></div>
        <div class="tape tape-right"></div>
        <div class="cat" aria-label="A smiling catgirl mascot" role="img">
          <span class="ear ear-left"></span>
          <span class="ear ear-right"></span>
          <span class="hair"></span>
          <span class="face">
            <i class="eye eye-left"></i>
            <i class="eye eye-right"></i>
            <i class="mouth"></i>
          </span>
        </div>
        <p class="kicker">you found her!</p>
        <h1>Catgirl<br />Sanctuary</h1>
        <p class="intro">Tiny paws. Big builds. Zero bugs.*</p>
        <button type="button" data-meow>deploy a meow</button>
        <p class="output" data-output aria-live="polite">waiting for headpats...</p>
        <small>* bugs become toys after midnight</small>
      </section>
      <a class="escape" href={`${base}/`}>← return to normal internet</a>
    </main>

    <script>
      const messages = ['mrrp!', 'nya~ build shipped!', 'prrrr...', '404: seriousness not found', 'headpat accepted ✓'];
      const button = document.querySelector('[data-meow]');
      const output = document.querySelector('[data-output]');
      let index = 0;

      button?.addEventListener('click', () => {
        if (!(output instanceof HTMLElement)) return;
        output.textContent = messages[index++ % messages.length];
        document.body.classList.remove('sparkle');
        requestAnimationFrame(() => document.body.classList.add('sparkle'));
      });
    </script>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Shrikhand&display=swap');

  :global(*) { box-sizing: border-box; }

  :global(body) {
    min-height: 100vh;
    margin: 0;
    color: #472d58;
    background-color: #ffd8e9;
    background-image:
      radial-gradient(circle, #fff 0 3px, transparent 4px),
      linear-gradient(135deg, transparent 45%, rgba(255, 255, 255, 0.32) 45% 55%, transparent 55%);
    background-size: 42px 42px, 90px 90px;
    font-family: 'DM Mono', monospace;
  }

  main {
    display: grid;
    place-items: center;
    min-height: 100vh;
    padding: 60px 20px 40px;
    overflow: hidden;
  }

  .secret {
    position: absolute;
    top: 14px;
    left: 18px;
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
  }

  .card {
    position: relative;
    width: min(520px, 100%);
    padding: 38px 28px 32px;
    text-align: center;
    background: #fffafc;
    border: 3px solid #472d58;
    box-shadow: 12px 12px 0 #a879ba;
    transform: rotate(-1deg);
  }

  .tape {
    position: absolute;
    top: -15px;
    width: 100px;
    height: 30px;
    background: rgba(255, 235, 132, 0.78);
  }

  .tape-left { left: -25px; transform: rotate(-7deg); }
  .tape-right { right: -25px; transform: rotate(8deg); }

  .cat {
    position: relative;
    width: 160px;
    height: 140px;
    margin: 0 auto 8px;
    animation: float 2.4s ease-in-out infinite;
  }

  .ear {
    position: absolute;
    top: 4px;
    width: 72px;
    height: 78px;
    background: #ae83c1;
    border: 3px solid #472d58;
    clip-path: polygon(50% 0, 100% 100%, 0 78%);
  }

  .ear-left { left: 5px; transform: rotate(-10deg); }
  .ear-right { right: 5px; transform: rotate(10deg) scaleX(-1); }

  .face {
    position: absolute;
    inset: 35px 20px 0;
    display: block;
    background: #ffd9c9;
    border: 3px solid #472d58;
    border-radius: 48% 48% 44% 44%;
  }

  .hair {
    position: absolute;
    z-index: 2;
    top: 24px;
    left: 22px;
    width: 116px;
    height: 56px;
    background: #ae83c1;
    border-radius: 55% 55% 35% 35%;
    clip-path: polygon(0 0, 100% 0, 100% 65%, 82% 47%, 68% 83%, 53% 45%, 37% 82%, 20% 48%, 0 72%);
  }

  .eye {
    position: absolute;
    z-index: 3;
    top: 58px;
    width: 18px;
    height: 8px;
    border-bottom: 4px solid #472d58;
    border-radius: 50%;
  }

  .eye-left { left: 25px; transform: rotate(8deg); }
  .eye-right { right: 25px; transform: rotate(-8deg); }

  .mouth {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 19px;
    width: 18px;
    height: 10px;
    border-right: 3px solid #472d58;
    border-bottom: 3px solid #472d58;
    border-radius: 0 0 12px;
    transform: translateX(-50%) rotate(45deg);
  }

  .kicker {
    margin: 0;
    color: #d63d7d;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 2px 0 10px;
    color: #7e4c98;
    font-family: 'Shrikhand', cursive;
    font-size: clamp(3.2rem, 13vw, 5.8rem);
    font-weight: 400;
    line-height: 0.82;
    text-shadow: 3px 3px 0 #ffd0e2;
  }

  .intro { margin: 22px 0 18px; }

  button {
    padding: 11px 18px;
    border: 3px solid #472d58;
    color: #472d58;
    background: #ffec79;
    box-shadow: 4px 4px 0 #472d58;
    font: 500 1rem 'DM Mono', monospace;
    cursor: pointer;
  }

  button:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 #472d58; }
  button:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 #472d58; }
  button:focus-visible { outline: 4px solid #e74e91; outline-offset: 4px; }

  .output {
    min-height: 24px;
    margin: 18px 0 8px;
    color: #d63d7d;
    font-weight: 500;
  }

  small { opacity: 0.72; }

  .escape {
    margin-top: 30px;
    color: #472d58;
    font-size: 0.8rem;
    text-decoration-thickness: 2px;
  }

  :global(body.sparkle)::after {
    content: '✦  ♡  ✧  ฅ  ✦  ♡';
    position: fixed;
    inset: 15% 0 auto;
    text-align: center;
    color: #d63d7d;
    font-size: clamp(2rem, 8vw, 5rem);
    pointer-events: none;
    animation: burst 0.7s ease-out both;
  }

  @keyframes float { 50% { transform: translateY(-7px) rotate(2deg); } }
  @keyframes burst { from { opacity: 1; transform: scale(0.4); } to { opacity: 0; transform: translateY(-90px) scale(1.3); } }

  @media (max-width: 480px) {
    .card { padding-inline: 16px; box-shadow: 8px 8px 0 #a879ba; }
    .secret { font-size: 0.62rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat, :global(body.sparkle)::after { animation: none; }
  }
</style>
